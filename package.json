    "react-native-mmkv": "3.3.3",
    "react-native-reanimated": "3.19.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.24.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
